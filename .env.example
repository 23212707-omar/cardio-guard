# Copia este archivo como .env y ajusta los valores. .env NO se sube a git.

# Dónde se guardan los pacientes: csv (por defecto) o sql
REPOSITORIO=csv

# Conexión a SQL Server (solo si REPOSITORIO=sql)
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=cardio_guard
DB_USER=cardio_guard_app
DB_PASSWORD=CAMBIAR_ESTA_CONTRASENA

# Opciones de conexión para SQL Server local (valores por defecto mostrados)
# DB_ENCRYPT=false
# DB_TRUST_SERVER_CERTIFICATE=true

# Solo para tests/storage.sql.manual.js: usuario CON permiso para crear bases de
# datos (cardio_guard_app NO lo tiene). El test crea y borra cardio_guard_test.
# DB_TEST_USER=
# DB_TEST_PASSWORD=
